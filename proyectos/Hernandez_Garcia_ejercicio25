<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tablas de Multiplicar 1-10</title>
    <style>
      /* Estilos para una presentación profesional */
      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f4f7f6;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 20px;
      }

      h1 {
        color: #2c3e50;
      }

      button {
        padding: 10px 20px;
        font-size: 16px;
        background-color: #2980b9;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background 0.3s;
      }

      button:hover {
        background-color: #3498db;
      }

      /* Contenedor Grid para organizar las 10 tablas */
      .grid-tablas {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 20px;
        width: 100%;
        max-width: 1200px;
        margin-top: 30px;
      }

      .tabla-card {
        background: white;
        padding: 15px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        text-align: center;
      }

      .tabla-card h3 {
        margin-top: 0;
        color: #2980b9;
        border-bottom: 2px solid #ecf0f1;
        padding-bottom: 10px;
      }

      .linea-tabla {
        margin: 5px 0;
        font-size: 14px;
        color: #34495e;
      }
    </style>
  </head>
  <body>
    <h1>Tablas de Multiplicar (1 al 10)</h1>
    <button id="btnGenerar">Generar tablas de multiplicar</button>

    <div id="tablasContainer" class="grid-tablas"></div>

    <script>
      const btn = document.getElementById("btnGenerar");
      const container = document.getElementById("tablasContainer");

      btn.addEventListener("click", () => {
        // Limpiamos el contenedor para evitar duplicados al dar clic varias veces
        container.innerHTML = "";

        // Ciclo Externo: Genera el número de la tabla (1 al 10)
        for (let i = 1; i <= 10; i++) {
          // Crear el elemento contenedor para cada tabla (Card)
          const card = document.createElement("div");
          card.className = "tabla-card";

          let contenido = `<h3>Tabla del ${i}</h3>`;

          // Ciclo Interno: Genera las multiplicaciones del 1 al 10
          for (let j = 1; j <= 10; j++) {
            const resultado = i * j;
            contenido += `<div class="linea-tabla">${i} x ${j} = <strong>${resultado}</strong></div>`;
          }

          card.innerHTML = contenido;
          container.appendChild(card);
        }
      });
    </script>
  </body>
</html>
