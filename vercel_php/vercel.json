    { "src": "/proyectos/practica21", "dest": "/api/proyectos/practica21.php" },
    { "src": "/proyectos/practica22", "dest": "/api/proyectos/practica22.php" },
    { "src": "/proyectos/practica23", "dest": "/api/proyectos/practica23.php" },
    { "src": "/proyectos/practica24", "dest": "/api/proyectos/practica24.php" },
    { "src": "/proyectos/practica25", "dest": "/api/proyectos/practica25.php" },
    { "src": "/proyectos/practica26", "dest": "/api/proyectos/practica26.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
