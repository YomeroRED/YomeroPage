{
  "functions": {
    "api/proyectos-php/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/data/(.*)", "dest": "/data/$1" },
    { "src": "/proyectos/(.*)", "dest": "/proyectos/$1" },

    { "src": "/practica27$", "dest": "/practica27.html" },
    {
      "src": "/practica27/practica21",
      "dest": "/api/proyectos-php/practica27/practica21.php"
    },
    {
      "src": "/practica27/practica22",
      "dest": "/api/proyectos-php/practica27/practica22.php"
    },
    {
      "src": "/practica27/practica23",
      "dest": "/api/proyectos-php/practica27/practica23.php"
    },
    {
      "src": "/practica27/practica24",
      "dest": "/api/proyectos-php/practica27/practica24.php"
    },
    {
      "src": "/practica27/practica25",
      "dest": "/api/proyectos-php/practica27/practica25.php"
    },
    {
      "src": "/practica27/practica26",
      "dest": "/api/proyectos-php/practica27/practica26.php"
    },

    { "src": "/practica28", "dest": "/api/proyectos-php/practica28.php" },

    { "src": "/practica29", "dest": "/api/proyectos-php/practica29.php" },

    { "src": "/practica30", "dest": "/api/proyectos-php/practica30.php" },

    { "src": "/practica31", "dest": "/api/proyectos-php/practica31.php" },

    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
